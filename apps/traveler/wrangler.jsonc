{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoysii-web",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "hoysii.com", "custom_domain": true },
    { "pattern": "www.hoysii.com", "custom_domain": true }
  ]
}
